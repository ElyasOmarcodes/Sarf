<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:padding="32dp">

    <TextView
        android:id="@+id/tv_blocked_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App Blocked"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tv_blocked_subtitle"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_blocked_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stay focused! This social media app is blocked."
        android:textSize="18sp"
        android:textAlignment="center"
        android:textColor="@color/surface"
        app:layout_constraintTop_toBottomOf="@id/tv_blocked_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_go_home"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_go_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Go Home"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/surface"
        android:textColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/tv_blocked_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
